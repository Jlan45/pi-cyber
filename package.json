{
  "name": "pi-cyber",
  "version": "0.1.0",
  "description": "Modular cybersecurity Pi package with working modes for pentest, reverse engineering, attribution, and remediation.",
  "type": "module",
  "keywords": [
    "pi-package",
    "cybersecurity",
    "pentest",
    "reverse-engineering",
    "attribution",
    "remediation"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/core/index.ts",
      "./extensions/pentest/index.ts",
      "./extensions/reverse/index.ts",
      "./extensions/attribution/index.ts",
      "./extensions/remediation/index.ts"
    ],
    "prompts": [
      "./prompts/*.md"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ssh2": "^1.15.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  }
}
